APP_ENV=development
DATABASE_URL=sqlite:///./data/cqa.db
CORS_ORIGINS=http://localhost:5173
DATASET_API_URL=
DATASET_API_TIMEOUT=30
IMPORT_MAX_BYTES=20971520
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=
LOG_LEVEL=INFO

# Stage 2: local inference; existing .env does not need to be replaced.
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=1
LLM_MAX_CONCURRENCY=1
LLM_CONTEXT_LENGTH=16384
LLM_MAX_OUTPUT_TOKENS=3072
LLM_RESPONSE_MODE=auto
LLM_THINK=false
LLM_SEED=42
LLM_KEEP_ALIVE=10m
LLM_ALLOW_REMOTE=false
AI_JOB_ENABLED=true
AI_AUTO_START_WORKER=false
AI_MAX_REPAIRS=2
AI_JOB_MAX_ATTEMPTS=2
AI_LEASE_SECONDS=90
AI_POLL_SECONDS=1
AI_RETRY_DELAY=10
AI_CHUNK_OVERLAP=2
AI_MAX_CHUNKS=64
AI_EXPLANATION_LANGUAGE=conversation
AI_SEMANTIC_REVIEW=true
