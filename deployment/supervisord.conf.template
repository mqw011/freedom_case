[unix_http_server]
file=@@ROOT@@/run/supervisor.sock
chmod=0700

[supervisord]
pidfile=@@ROOT@@/run/supervisord.pid
logfile=@@ROOT@@/logs/supervisord.log
logfile_maxbytes=5MB
logfile_backups=3
childlogdir=@@ROOT@@/logs
umask=0077

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://@@ROOT@@/run/supervisor.sock

[program:ollama]
command=@@PYTHON@@ @@RELEASE@@/scripts/production_service.py --root @@ROOT@@ ollama
priority=10
autostart=true
autorestart=true
startsecs=5
startretries=20
stopasgroup=true
killasgroup=true
stopwaitsecs=60
redirect_stderr=true
stdout_logfile=@@ROOT@@/logs/ollama.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3

[program:api]
command=@@PYTHON@@ @@RELEASE@@/scripts/production_service.py --root @@ROOT@@ api
priority=20
autostart=true
autorestart=true
startsecs=3
startretries=20
stopasgroup=true
killasgroup=true
stopwaitsecs=60
redirect_stderr=true
stdout_logfile=@@ROOT@@/logs/api.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3

[program:worker]
command=@@PYTHON@@ @@RELEASE@@/scripts/production_service.py --root @@ROOT@@ worker
priority=30
; Enable only after auditing imported queued jobs and pinned model configurations.
autostart=@@WORKER_START@@
autorestart=true
startsecs=1
; A stale 90-second lease must expire before a replacement can acquire it.
startretries=120
stopasgroup=true
killasgroup=true
stopwaitsecs=90
redirect_stderr=true
stdout_logfile=@@ROOT@@/logs/worker.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3

[program:proxy]
command=@@NGINX@@ -c @@ROOT@@/config/nginx.conf -g "daemon off;"
priority=40
autostart=true
autorestart=true
startsecs=3
startretries=20
stopsignal=QUIT
stopasgroup=true
killasgroup=true
stopwaitsecs=30
redirect_stderr=true
stdout_logfile=@@ROOT@@/logs/proxy.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=3

[eventlistener:backup]
command=@@PYTHON@@ @@RELEASE@@/scripts/production_service.py --root @@ROOT@@ backup
priority=50
events=TICK_3600
buffer_size=4
autostart=true
autorestart=true
startsecs=1
startretries=20
stderr_logfile=@@ROOT@@/logs/backup.log
stderr_logfile_maxbytes=5MB
stderr_logfile_backups=3
